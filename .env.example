# Local server
PORT=5187
HOST=127.0.0.1

# Strava API application: https://www.strava.com/settings/api
# Authorization callback domain must match STRAVA_REDIRECT_URI exactly.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://127.0.0.1:5187/api/strava/callback

# Set to 1 only when serving over HTTPS.
COOKIE_SECURE=0

# Overpass API endpoints and identifying User-Agent.
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT="JejakLariLocal/0.2 (local development)"
